// prisma/schema.prisma
// Planificator — Schéma de base de données V1
// Modèle multi-tenant SaaS : isolation par companyId sur toutes les tables métier

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN  // Accès global, gère toutes les entreprises
  ADMIN        // Gère son entreprise uniquement
  TEAM_LEADER  // Consulte et confirme/refuse les affectations de son équipe
  EMPLOYEE     // Consulte son propre planning
  CLIENT       // Consulte ses chantiers et le planning associé
}

enum WorksiteStatus {
  PLANNED      // Planifié, pas encore commencé
  IN_PROGRESS  // En cours
  COMPLETED    // Terminé — archivage automatique après 48h
  ARCHIVED     // Archivé définitivement
  EXTENDED     // Prolongé au-delà de la date de fin initiale
  DELAYED      // Décalé — démarrage repoussé à une date ultérieure
}

enum AssignmentStatus {
  PENDING    // En attente de confirmation par le chef d'équipe
  CONFIRMED  // Confirmé
  REFUSED    // Refusé avec raison obligatoire
}

enum DocumentType {
  PLAN      // Plan de chantier
  PHOTO     // Photo de chantier
  DOCUMENT  // Document administratif ou technique
}

enum InvitationStatus {
  PENDING    // Invitation envoyée, non encore acceptée
  ACCEPTED   // Compte créé via le lien d'invitation
  EXPIRED    // Délai d'expiration dépassé
  CANCELLED  // Annulée manuellement par un admin
}

enum AbsenceType {
  VACATION  // Congés payés
  SICK      // Arrêt maladie
  UNPAID    // Congé sans solde
  TRAINING  // Formation
  OTHER     // Autre motif
}

enum AbsenceStatus {
  PENDING   // En attente de validation
  APPROVED  // Validée
  REJECTED  // Refusée
}

enum PendingAccommodationStatus {
  PENDING    // En attente de validation admin
  CONFIRMED  // Admin a confirmé → Accommodation créé
  DISMISSED  // Admin a ignoré
}

/// Canal d'origine d'un PendingAccommodation (PLAN-BOOKING-FINAL-2).
enum PendingAccommodationSourceKind {
  GMAIL
  N8N
  AGENT
  MANUAL
}

/// Cycle de vie d'un message Gmail Booking (table processed_gmail_messages).
/// Les lignes historiques sans statut explicite sont migrées en SUCCEEDED.
enum BookingGmailMessageStatus {
  PROCESSING
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENTLY_IGNORED
}

/// Type de résultat produit par le scan Booking (traçabilité).
enum BookingGmailResultType {
  ACCOMMODATION
  PENDING_ACCOMMODATION
  CANCELLATION
  IGNORED
}

enum NotificationType {
  ASSIGNMENT_CREATED      // Nouvelle affectation créée
  ASSIGNMENT_CONFIRMED    // Affectation confirmée
  ASSIGNMENT_REFUSED      // Affectation refusée
  WORKSITE_UPDATED        // Chantier modifié
  WORKSITE_ARCHIVED       // Chantier archivé
  WORKSITE_EXTENDED       // Chantier prolongé
  INVITATION_SENT         // Invitation envoyée
  ABSENCE_REQUESTED       // Absence soumise
  ABSENCE_APPROVED        // Absence validée
  ABSENCE_REJECTED        // Absence refusée
  EXPENSE_SUBMITTED       // Note de frais soumise
  EXPENSE_APPROVED        // Note de frais approuvée
  EXPENSE_REJECTED        // Note de frais refusée
  TIMECLOCK_IN            // Pointage arrivée
  TIMECLOCK_OUT           // Pointage départ
  ACCOMMODATION_CREATED   // Logement réservé
  ACCOMMODATION_CANCELLED // Logement annulé
  BOOKING_DETECTED        // Email Booking.com détecté, en attente de validation

  // Véhicules V3 — ajouts des lots isolés.
  VEHICLE_DOCUMENT_EXPIRING // V3 : document véhicule bientôt échu (rappel interne)
  VEHICLE_DOCUMENT_EXPIRED  // V3 : document véhicule expiré (rappel interne)
}

enum AccommodationStatus {
  UPCOMING   // Réservation future
  ACTIVE     // Séjour en cours
  COMPLETED  // Terminé
  CANCELLED  // Annulé
}

enum ExpenseCategory {
  TRANSPORT     // Transport / carburant / péage
  REPAS         // Repas / restauration
  HEBERGEMENT   // Hébergement
  MATERIEL      // Matériel / fournitures
  OTHER         // Autre
}

enum QuoteStatus {
  DRAFT     // Brouillon (préparé à la main ou par l'agent IA)
  SENT      // Envoyé au client
  ACCEPTED  // Accepté par le client
  REFUSED   // Refusé
  EXPIRED   // Expiré (au-delà de validUntil)
  CONVERTED // Converti en facture (Lot C1)
}

enum InvoiceStatus {
  DRAFT      // Brouillon (modifiable, non émis)
  SENT       // Émise / envoyée au client (immuable)
  PAID       // Payée (immuable)
  CANCELLED  // Brouillon abandonné, ou facture émise annulée PAR AVOIR (jamais de retour arrière)
  PARTIAL    // Lot C2 : partiellement payée (Σ paiements entre 0 et TTC, exclus)
}

/// Lot C2 — mode de règlement d'un paiement.
enum PaymentMethod {
  TRANSFER
  CHECK
  CASH
  CARD
  DIRECT_DEBIT
  OTHER
}

/// Lot B minimal (ADR-PLAN-003) : une facture émise ne s'annule que par un avoir référencé.
enum InvoiceKind {
  INVOICE      // Facture
  CREDIT_NOTE  // Avoir total émis sur une facture SENT/PAID
  DEPOSIT      // Lot C3 : facture d'acompte (vraie facture, déduite sur la facture de solde)
}

enum ExpenseStatus {
  PENDING   // En attente de validation
  APPROVED  // Validée
  REJECTED  // Refusée
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  STORMY
  WINDY
  SNOW
}

enum AcquisitionSource {
  GMAIL
}

enum AcquisitionMessageStatus {
  RECEIVED
  ELIGIBLE
  REJECTED
  DRAFT_CREATED
  PROCESSING
  PROCESSED
  FAILED
}

enum WorksiteImportDraftStatus {
  PENDING_EXTRACTION
  EXTRACTING
  PENDING_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  FAILED
  /// Consultation authentique dont la période de prestation est terminée (≠ REJECTED).
  OBSOLETE
}

/// PLAN-ACQ-DETECTION-001 — Classification Detection pré-extraction (fail-closed si NULL).
enum AcquisitionConsultationClassification {
  CONSULTATION
  CONSULTATION_UPDATE
  CANCELLATION
  NON_CONSULTATION
  AMBIGUOUS
}

enum AcquisitionAttachmentStatus {
  DISCOVERED
  PENDING_DOWNLOAD
  STORED
  REJECTED
  FAILED
}

enum AcquisitionAttachmentAccessAction {
  VIEW
  DOWNLOAD
}

enum AcquisitionAttachmentAccessOutcome {
  GRANTED
  DENIED
}

enum AcquisitionAttachmentCategory {
  PLAN
  PHOTO
  DOCUMENT
  ARCHIVE
  UNSUPPORTED
  UNKNOWN
}

enum HistoryAction {
  CREATED        // Entité créée
  UPDATED        // Entité modifiée
  DELETED        // Entité supprimée
  ASSIGNED       // Équipe ou employé affecté
  UNASSIGNED     // Affectation supprimée
  CONFIRMED      // Affectation confirmée
  REFUSED        // Affectation refusée
  EXTENDED       // Chantier prolongé
  ARCHIVED       // Chantier archivé
  COMPLETED      // Chantier marqué terminé
  INVITED        // Invitation envoyée
  STATUS_CHANGED // Changement de statut
  MEMBER_ADDED   // Membre ajouté à une équipe
  MEMBER_REMOVED // Membre retiré d'une équipe
  LEADER_CHANGED // Chef d'équipe changé
}

/// PLAN-INTEGRATION-PLATFORM-001 — LOT-1B1 — Machine d'état Connection.
enum IntegrationConnectionStatus {
  PENDING_AUTH
  ACTIVE
  DISABLED
  ERROR
  ARCHIVED
}

/// PLAN-INTEGRATION-PLATFORM-001 — LOT-1B1 — Machine credentials (agrégat).
enum IntegrationCredentialStatus {
  MISSING
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  RETIRED
  FAILED
}

/// PLAN-INTEGRATION-PLATFORM-001 — LOT-1B1 — Santé runtime Connection.
enum IntegrationRuntimeHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

/// PLAN-INTEGRATION-PLATFORM-001 — LOT-1B1 — Discriminateur secretBackend.
enum IntegrationSecretBackend {
  LEGACY_GMAIL
  PLATFORM_ENCRYPTED
}

/// PLAN-INTEGRATION-PLATFORM-001 — LOT-1B2 — Lifecycle InboundEnvelope.
enum EnvelopeLifecycleStatus {
  RECEIVED
  NORMALIZED
  NORMALIZE_FAILED
  ROUTED
  NO_MATCH
  AMBIGUOUS
  DISPATCHED
  DISCARDED
  ARCHIVED
}

/// PLAN-INTEGRATION-PLATFORM-001 — LOT-1B2 — Famille NormalizedInbound (V1 MESSAGE-only).
enum InboundFamily {
  MESSAGE
}

// ─── Module Tâches (V1) ───────────────────────────────────────────────────────

enum TaskStatus {
  TODO         // À faire
  IN_PROGRESS  // En cours
  DONE         // Terminée
}

enum TaskPriority {
  LOW     // Basse
  MEDIUM  // Moyenne
  HIGH    // Haute
}

// ═══════════════════════════════════════════════════════════════════════════
// COMPANY — Tenant racine
// Toutes les données métier sont isolées par companyId
// ═══════════════════════════════════════════════════════════════════════════

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // prévu pour les sous-domaines futurs (ex: acme.planificator.fr)
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  siret     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                   User[]
  employees               Employee[]
  teams                   Team[]
  clients                 Client[]
  worksites               Worksite[]
  invitations             Invitation[]
  notifications           Notification[]
  historyLogs             HistoryLog[]
  absences                Absence[]
  expenseReports          ExpenseReport[]
  timeclocks              Timeclock[]
  settings                CompanySettings?
  accommodations          Accommodation[]
  gmailConnection         GmailConnection?
  processedGmailMessages  ProcessedGmailMessage[]
  pendingAccommodations   PendingAccommodation[]
  articles                Article[]
  quotes                  Quote[]
  invoices                Invoice[]
  accountingAccounts      AccountingAccount[]
  accountingJournals      AccountingJournal[]
  fiscalYears             FiscalYear[]
  journalEntries          JournalEntry[]
  journalEntryLines       JournalEntryLine[]
  accountingSequences     AccountingSequence[]
  accountingChainHeads    AccountingChainHead[]
  documentCounters        DocumentCounter[]
  billingSettings         BillingSettings?
  billingMailLogs         BillingMailLog[]
  invoicePayments         InvoicePayment[]
  invoiceDepositDeductions InvoiceDepositDeduction[]
  invoiceDocumentSnapshots InvoiceDocumentSnapshot[] // Correctif P2-03
  accountingDocumentPostings AccountingDocumentPosting[]
  suppliers               Supplier[]
  supplierInvoices        SupplierInvoice[]
  supplierInvoiceFiles    SupplierInvoiceFile[]
  bankStatementImports    BankStatementImport[]
  bankTransactions        BankTransaction[]
  vatDeclarations         VatDeclaration[]
  acquisitionMessages     AcquisitionMessage[]
  worksiteImportDrafts    WorksiteImportDraft[]
  acquisitionAttachments  AcquisitionAttachment[]
  acquisitionScanCursors  AcquisitionScanCursor[]
  acquisitionGmailConnections AcquisitionGmailConnection[]
  acquisitionAttachmentAccessLogs AcquisitionAttachmentAccessLog[]
  acquisitionMessageContents AcquisitionMessageContent[]
  acquisitionContentFetchStates AcquisitionContentFetchState[]
  acquisitionPartners         AcquisitionPartner[]
  acquisitionPartnerDomains   AcquisitionPartnerDomain[]
  acquisitionPartnerEmails    AcquisitionPartnerEmail[]
  acquisitionDecisionJournals AcquisitionDecisionJournal[]
  integrationConnections      IntegrationConnection[]
  inboundEnvelopes            InboundEnvelope[]
  normalizedInbounds          NormalizedInbound[]
  trucks                      Truck[]
  truckAssignments            TruckAssignment[]
  mileageEntries              MileageEntry[]
  mileageTrips                MileageTrip[]
  maintenancePlans            VehicleMaintenancePlan[]
  maintenanceEntries          VehicleMaintenanceEntry[]
  tasks                       Task[]
  /// PLAN-AGENT-GATEWAY-001 — LOT-1A (relation inverse, sans effet SQL sur companies)
  agentPrincipals             AgentPrincipal[]

  @@map("companies")

  // Véhicules V3 — ajouts des lots isolés.
  vehicleCartographyCache VehicleCartographyCache[]
  vehicleImportProviderWindows VehicleImportProviderWindow[]
  vehicleDocuments            VehicleDocument[]
  vehicleDocumentVersions     VehicleDocumentVersion[]
  vehicleDocumentReminderSetting VehicleDocumentReminderSetting?
  vehicleDocumentReminders    VehicleDocumentReminder[]
  vehicleAuditLogs            VehicleAuditLog[]
}

// Paramètres de l'entreprise — extensible sans toucher au schéma principal
model CompanySettings {
  id                    String @id @default(cuid())
  companyId             String @unique
  defaultDailyHours     Float  @default(10)   // heures travaillées par journée
  archiveDelayHours     Int    @default(48)   // délai avant archivage auto après COMPLETED
  invitationExpiryHours Int    @default(24)   // durée de validité des liens d'invitation
  timezone              String @default("Europe/Paris")
  primaryColor          String @default("#0f3460")

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// ARTICLE — Bibliothèque d'articles (catalogue prix pour devis & factures)
// Réservé ADMIN / SUPER_ADMIN. Suppression douce via `active` pour préserver
// l'historique des devis/factures qui référenceront ces articles.
// ═══════════════════════════════════════════════════════════════════════════

model Article {
  id          String   @id @default(cuid())
  companyId   String
  reference   String?          // code article optionnel (ex: "PLB-001")
  designation String           // libellé de l'article
  description String?          // détail optionnel
  unit        String   @default("u")            // unité : u, m², ml, h, forfait…
  unitPrice   Decimal  @db.Decimal(10, 2)       // prix unitaire HT
  vatRate     Decimal  @default(20) @db.Decimal(5, 2) // taux de TVA % (par article)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteLines   QuoteLine[]
  invoiceLines InvoiceLine[]

  @@index([companyId])
  @@map("articles")
}

// ═══════════════════════════════════════════════════════════════════════════
// FACTURATION — Devis (Quote) & Factures (Invoice)
//
// Réservé ADMIN / SUPER_ADMIN. Chaque document est rattaché à un chantier et
// à son client. Les lignes FIGENT designation/prix/TVA au moment de la création
// (obligation légale : un document émis est immuable même si le catalogue change).
// Numérotation séquentielle sans trou via DocumentCounter (par entreprise/an).
// ═══════════════════════════════════════════════════════════════════════════

model Quote {
  id          String      @id @default(cuid())
  companyId   String
  worksiteId  String
  clientId    String
  number      String      // "DEV-2026-0001" (séquentiel, unique par entreprise)
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  validUntil  DateTime?   // date de validité du devis
  totalHT     Decimal     @default(0) @db.Decimal(10, 2)
  totalVAT    Decimal     @default(0) @db.Decimal(10, 2)
  totalTTC    Decimal     @default(0) @db.Decimal(10, 2)
  notes       String?     // notes / conditions particulières
  paymentTerms String?    // conditions de paiement (mention légale)
  createdById String      // userId de l'admin créateur
  sentAt      DateTime?   // date d'envoi au client
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Lot C1 (SPEC-BILLING-C1) — colonnes additives, calculs en centimes (BigInt) côté service.
  subject                 String?
  globalDiscountBp        Int       @default(0)     // remise globale en points de base (250 = 2,50 %)
  vatReverseCharge        Boolean   @default(false) // autoliquidation (art. 283-2 nonies CGI)
  acceptedAt              DateTime?
  refusedAt               DateTime?
  refusalReason           String?
  expiredAt               DateTime?
  convertedAt             DateTime?
  signerName              String?
  signedAt                DateTime?
  signatureIpHash         String?   // sha256 de l'adresse IP du signataire (jamais en clair)
  signatureTokenHash      String?   @unique // sha256 du jeton de signature (jeton jamais stocké)
  signatureTokenExpiresAt DateTime?
  reminderJ3SentAt        DateTime?
  reminderJ7SentAt        DateTime?
  reminderJ15SentAt       DateTime?
  importRef               String?   // référence externe d'import (unique par société)

  // Relations
  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worksite Worksite    @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  client   Client      @relation(fields: [clientId], references: [id])
  lines    QuoteLine[]
  invoices Invoice[]   // factures issues de ce devis

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@unique([companyId, importRef])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, issueDate])
  @@index([worksiteId])
  @@index([clientId])
  @@index([status])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  articleId   String?           // lien optionnel vers le catalogue
  designation String            // libellé figé
  unit        String  @default("u")
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)  // prix HT figé
  vatRate     Decimal @db.Decimal(5, 2)   // TVA figée
  lineHT      Decimal @db.Decimal(10, 2)  // quantity * unitPrice (après remise de ligne, Lot C1)
  position    Int     @default(0)         // ordre d'affichage
  description String?                     // Lot C1 : détail facultatif
  discountBp  Int     @default(0)         // Lot C1 : remise de ligne en points de base

  // Relations
  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id])

  @@index([quoteId])
  @@map("quote_lines")
}

model Invoice {
  id          String        @id @default(cuid())
  companyId   String
  worksiteId  String
  clientId    String
  quoteId     String?       // devis d'origine (optionnel)
  number      String        // "FAC-2026-0001" (séquentiel, unique par entreprise)
  status      InvoiceStatus @default(DRAFT)
  kind        InvoiceKind   @default(INVOICE)
  creditedInvoiceId String?       // avoir : facture d'origine (Lot C4 : index unique partiel « un seul avoir TOTAL », plusieurs PARTIAL)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?     // échéance de paiement
  periodStart DateTime?     // début de la période facturée (= dates du chantier)
  periodEnd   DateTime?     // fin de la période facturée
  totalHT     Decimal       @default(0) @db.Decimal(10, 2)
  totalVAT    Decimal       @default(0) @db.Decimal(10, 2)
  totalTTC    Decimal       @default(0) @db.Decimal(10, 2)
  notes       String?
  paymentTerms String?      // conditions de paiement (mention légale)
  createdById String        // userId de l'admin créateur
  sentAt      DateTime?     // date d'envoi au client
  paidAt      DateTime?     // date de règlement
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Lot C1 : remise globale et autoliquidation (copiées du devis ; utilisées par C2–C4).
  globalDiscountBp Int     @default(0)
  vatReverseCharge Boolean @default(false)
  // Lot C2 : objet, relances après échéance (J+30/45/60), paiements.
  subject             String?
  reminderDue30SentAt DateTime?
  reminderDue45SentAt DateTime?
  reminderDue60SentAt DateTime?
  payments            InvoicePayment[]
  // Lot C3 : acomptes (pourcentage demandé ; déductions sur la facture de solde).
  depositBp           Int?
  depositDeductions   InvoiceDepositDeduction[] @relation("FinalInvoiceDeductions")
  deductedBy          InvoiceDepositDeduction[] @relation("DepositInvoiceDeductions")
  deductionLines      InvoiceLine[]             @relation("LineDeductsDeposit")
  // Lot C4 : avoirs partiels (TOTAL = Lot B, PARTIAL = plafonné au restant créditable).
  creditScope         InvoiceCreditScope?
  creditReason        String?
  // Lot C5 : rapprochement bancaire.
  bankTransactions    BankTransaction[] @relation("BankMatchedInvoice")

  // Relations
  // Lot B : pièces conservées — aucune suppression en cascade depuis la société ou le chantier.
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  worksite Worksite      @relation(fields: [worksiteId], references: [id], onDelete: Restrict)
  client   Client        @relation(fields: [clientId], references: [id])
  quote    Quote?        @relation(fields: [companyId, quoteId], references: [companyId, id], onDelete: Restrict) // Correctif P2-02 : FK composite société
  lines    InvoiceLine[]
  documentSnapshots InvoiceDocumentSnapshot[] // Correctif P2-03 : données documentaires figées à l'émission (au plus une : invoiceId UNIQUE en base)
  creditedInvoice Invoice?  @relation("InvoiceCreditNote", fields: [creditedInvoiceId], references: [id], onDelete: Restrict)
  creditNotes     Invoice[] @relation("InvoiceCreditNote") // Lot C4 : plusieurs avoirs partiels ; un seul TOTAL (index partiel SQL)

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([creditedInvoiceId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, issueDate])
  @@index([companyId, dueDate])
  @@index([worksiteId])
  @@index([clientId])
  @@index([status])
  @@index([kind])
  @@map("invoices")
}

/// Lot C2 (SPEC-BILLING-C2) — paiement d'une facture émise : append-only (contre-passation par ligne opposée),
/// montant en centimes, FK composite (companyId, invoiceId) → même société garantie en base.
model InvoicePayment {
  id                String        @id @default(cuid())
  companyId         String
  invoiceId         String
  amountCents       BigInt        // négatif uniquement pour une contre-passation
  method            PaymentMethod
  paidAt            DateTime      @db.Date
  reference         String?
  notes             String?
  recordedById      String
  reversesPaymentId String?       @unique
  reversedAt        DateTime?
  bankTransactionId String?       @unique // Correctif P1-03 : opération bancaire à l'origine du paiement (un seul paiement par opération)
  createdAt         DateTime      @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice  Invoice        @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  reverses InvoicePayment? @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversedBy InvoicePayment? @relation("PaymentReversal")
  // Relations déclarées en liste côté Prisma (FK composites société) ; l'unicité réelle est garantie en base
  // (bank_transactions.matchedPaymentId UNIQUE, invoice_payments.bankTransactionId UNIQUE).
  bankTransactions BankTransaction[] @relation("BankMatchedPayment") // Lot C5 : opération qui référence ce paiement
  reconciles       BankTransaction?  @relation("PaymentBankTransaction", fields: [companyId, bankTransactionId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([invoiceId])
  @@index([companyId, paidAt])
  @@map("invoice_payments")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  articleId   String?
  designation String
  unit        String  @default("u")
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  lineHT      Decimal @db.Decimal(10, 2)
  position    Int     @default(0)
  description String?                 // Lot C1
  discountBp  Int     @default(0)     // Lot C1 : remise de ligne en points de base
  deductsDepositId String?            // Lot C3 : ligne de déduction d'un acompte (facture de solde)

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)
  deductsDeposit Invoice? @relation("LineDeductsDeposit", fields: [deductsDepositId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([deductsDepositId])
  @@map("invoice_lines")
}

/// Lot C3 (SPEC-BILLING-C3) — un acompte émis n'est déduit qu'une fois, sur une facture de solde du même devis.
model InvoiceDepositDeduction {
  id               String   @id @default(cuid())
  companyId        String
  finalInvoiceId   String
  depositInvoiceId String   @unique
  amountTTCCents   BigInt
  createdAt        DateTime @default(now())

  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  finalInvoice Invoice @relation("FinalInvoiceDeductions", fields: [companyId, finalInvoiceId], references: [companyId, id], onDelete: Restrict)
  deposit      Invoice @relation("DepositInvoiceDeductions", fields: [companyId, depositInvoiceId], references: [companyId, id], onDelete: Restrict)

  @@index([finalInvoiceId])
  @@map("invoice_deposit_deductions")
}

/// Correctif P2-03 — snapshot documentaire d'une pièce émise (vendeur, acheteur, mentions, conditions, pied de page, références),
/// figé à l'émission, immuable en base (déclencheur) ; les montants/lignes restent protégés par les déclencheurs Lot B/C.
model InvoiceDocumentSnapshot {
  id            String   @id @default(cuid())
  companyId     String
  invoiceId     String   @unique
  schemaVersion Int      @default(1)
  seller        Json
  buyer         Json
  document      Json
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId])
  @@map("invoice_document_snapshots")
}

/// Lot C4 — portée d'un avoir.
enum InvoiceCreditScope {
  TOTAL
  PARTIAL
}

// ═══════════════════════════════════════════════════════════════════════════
// FACTURATION COMPLÈTE — Lot C1 (SPEC-BILLING-C1) : paramètres de facturation et journal des courriers.
// ═══════════════════════════════════════════════════════════════════════════

enum VatRegime {
  DEBITS        // TVA sur les débits (facturation)
  ENCAISSEMENTS // TVA sur les encaissements (prestations de services)
}

model BillingSettings {
  id                String    @id @default(cuid())
  companyId         String    @unique
  vatNumber         String?   // TVA intracommunautaire du vendeur
  legalForm         String?   // SARL, SAS, EI…
  shareCapital      String?   // "10 000 €"
  rcs               String?   // "RCS Paris 123 456 789"
  iban              String?
  bic               String?
  quoteValidityDays Int       @default(30)
  paymentTermsDays  Int       @default(30)
  latePenaltyText   String?   // remplace la mention par défaut (pénalités, indemnité forfaitaire 40 €)
  quoteFooter       String?
  invoiceFooter     String?
  vatRegime         VatRegime @default(DEBITS)
  defaultDepositBp  Int       @default(3000) // 30 %
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("billing_settings")
}

enum BillingMailStatus {
  SIMULATED // courrier journalisé, non envoyé (drapeau BILLING_MAIL_ENABLED absent)
  SENT
  FAILED
}

model BillingMailLog {
  id           String            @id @default(cuid())
  companyId    String
  kind         String            // QUOTE_SENT | QUOTE_REMINDER_J3 | … | INVOICE_SENT | INVOICE_REMINDER_30 | …
  to           String
  subject      String
  documentType String            // "Quote" | "Invoice"
  documentId   String
  status       BillingMailStatus
  providerId   String?
  error        String?
  createdAt    DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, documentType, documentId])
  @@index([companyId, createdAt])
  @@map("billing_mail_logs")
}

// Compteur pour la numérotation séquentielle légale (sans trou), par entreprise/type/an.
model DocumentCounter {
  id        String @id @default(cuid())
  companyId String
  type      String // "QUOTE" | "INVOICE" | "CREDIT_NOTE"
  year      Int
  lastValue Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, year])
  @@map("document_counters")
}

// ═══════════════════════════════════════════════════════════════════════════
// USER — Compte de connexion uniquement
// Séparé volontairement de Employee (fiche métier)
// companyId est null uniquement pour le SUPER_ADMIN
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String    // bcrypt hash
  role        Role      @default(EMPLOYEE)
  active      Boolean   @default(true)
  companyId   String?   // null uniquement pour SUPER_ADMIN
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employeeProfiles Employee[]       // présent pour ADMIN, TEAM_LEADER, EMPLOYEE
  clientProfile   ClientProfile?  // présent pour CLIENT uniquement
  sentInvitations Invitation[]    @relation("InvitedBy")
  passwordResets  PasswordReset[]
  notifications   Notification[]
  historyLogs     HistoryLog[]    @relation("HistoryActor")
  reviewedImportDrafts WorksiteImportDraft[] @relation("ImportDraftReviewer")
  acquisitionAttachmentAccessLogs AcquisitionAttachmentAccessLog[]
  /// PLAN-AGENT-GATEWAY-001 — LOT-1A (relation inverse, sans effet SQL sur users)
  createdAgentPrincipals AgentPrincipal[] @relation("AgentPrincipalCreatedBy")
  skippedTourStops VehicleTourStop[] @relation("TourStopSkippedBy")
  mileageEntries MileageEntry[] @relation("MileageAuthor")
  maintenanceEntries VehicleMaintenanceEntry[] @relation("MaintenanceAuthor")
  updatedMaintenancePlans VehicleMaintenancePlan[] @relation("MaintenancePlanAuthor")

  @@index([companyId])
  @@index([email])
  @@map("users")

  // Véhicules V3 — ajouts des lots isolés.
  vehicleDocumentsCreated VehicleDocument[] @relation("VehicleDocumentAuthor")
  vehicleDocumentVersionsUploaded VehicleDocumentVersion[] @relation("VehicleDocumentVersionAuthor")
  vehicleAuditLogs VehicleAuditLog[] @relation("VehicleAuditActor")
}

// ═══════════════════════════════════════════════════════════════════════════
// EMPLOYEE — Fiche métier de l'employé
// Séparée de User pour permettre une gestion RH indépendante du compte
// Les affectations pointent vers Employee, pas vers User
// ═══════════════════════════════════════════════════════════════════════════

model Employee {
  id        String    @id @default(cuid())
  userId    String    // un compte, une fiche par entreprise
  role      Role      @default(EMPLOYEE)
  companyId String
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  jobTitle  String?
  active    Boolean   @default(true)
  hiredAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamMemberships     TeamMember[]
  ledTeams            Team[]               @relation("TeamLeader")
  employeeAssignments EmployeeAssignment[]
  absences            Absence[]
  expenseReports      ExpenseReport[]
  timeclocks          Timeclock[]
  dailyReports        DailyReport[]
  signatures          Signature[]
  drivenTrucks        Truck[]              @relation("TruckChauffeur")
  truckAssignments    TruckAssignment[]    @relation("TruckAssignmentChauffeur")
  mileageTrips        MileageTrip[]        @relation("MileageDriver")
  assignedTasks       Task[]               @relation("TaskAssignee")

  @@unique([id, companyId])
  @@index([companyId])
  @@index([userId])
  @@unique([userId, companyId])
  @@map("employees")
}

// ═══════════════════════════════════════════════════════════════════════════
// TEAM — Équipe de travail
// Chef d'équipe obligatoire (leaderId non nullable)
// ═══════════════════════════════════════════════════════════════════════════

model Team {
  id        String   @id @default(cuid())
  name      String
  color     String?  // couleur hex pour le calendrier ex: #FF5733
  companyId String
  leaderId  String   // employeeId — chef d'équipe obligatoire
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leader         Employee        @relation("TeamLeader", fields: [leaderId], references: [id])
  members        TeamMember[]
  assignments    Assignment[]
  dailyReports   DailyReport[]
  accommodations Accommodation[]
  truck          Truck?
  truckHistory   TruckAssignment[] @relation("TruckAssignmentTeam")
  mileageTrips   MileageTrip[]     @relation("MileageTeam")

  @@unique([id, companyId])
  @@unique([name, companyId]) // pas de doublon de nom d'équipe dans la même entreprise
  @@index([companyId])
  @@index([leaderId])
  @@map("teams")
}

// Table pivot Équipe ↔ Employé avec historique des appartenances
model TeamMember {
  id         String    @id @default(cuid())
  teamId     String
  employeeId String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime? // null = membre actif, renseigné = membre parti

  // Relations
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
  @@map("team_members")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENT
// ═══════════════════════════════════════════════════════════════════════════

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  companyId String
  active    Boolean  @default(true)
  siret     String?  // Lot C1 : mentions de facturation (SIRET/SIREN du client)
  vatNumber String?  // Lot C1 : TVA intracommunautaire du client
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worksites           Worksite[]
  clientProfile       ClientProfile?
  quotes              Quote[]
  invoices            Invoice[]
  importDrafts        WorksiteImportDraft[]
  /// PLAN-ACQ-CONSULTATIONS-FIX-001 — partenaires liés (FK composite tenant-safe)
  acquisitionPartners AcquisitionPartner[]

  @@index([companyId])
  // Cible FK composite AcquisitionPartner.(clientId, companyId)
  @@unique([id, companyId])
  @@map("clients")
}

// Lien entre un Client et son compte User pour l'accès au portail client
model ClientProfile {
  id       String @id @default(cuid())
  clientId String @unique
  userId   String @unique

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSITE — Chantier
// completedAt et archivedAt gèrent l'archivage automatique 48h
// ═══════════════════════════════════════════════════════════════════════════

model Worksite {
  id          String         @id @default(cuid())
  name        String
  description String?
  address     String?
  latitude    Float?         // prévu pour une carte future
  longitude   Float?
  status      WorksiteStatus @default(PLANNED)
  startDate   DateTime? // null = dates inconnues (Acquisition)
  endDate     DateTime? // null = dates inconnues (Acquisition)
  dailyHours  Float          @default(10)   // heures de travail par journée
  clientId    String
  companyId   String
  createdById String         // userId de l'admin qui a créé le chantier
  completedAt DateTime?      // date de passage au statut COMPLETED
  archivedAt  DateTime?      // date d'archivage effectif
  delayedUntil DateTime?     // date de décalage (statut DELAYED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  client       Client        @relation(fields: [clientId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents    Document[]
  assignments  Assignment[]
  extensions   Extension[]
  historyLogs  HistoryLog[]
  timeclocks   Timeclock[]
  dailyReports DailyReport[]
  quotes       Quote[]
  invoices     Invoice[]
  importDrafts WorksiteImportDraft[]
  mileageTrips MileageTrip[] @relation("MileageWorksite")
  tasks        Task[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([createdById])
  @@map("worksites")
}

// ═══════════════════════════════════════════════════════════════════════════
// DOCUMENT — Fichier attaché à un chantier (plan, photo, document)
// ═══════════════════════════════════════════════════════════════════════════

model Document {
  id         String       @id @default(cuid())
  worksiteId String
  name       String
  // Nullable : documents bridgés Acquisition (005D) n’ont pas d’URL publique.
  // L’accès se fait via sourceAcquisitionAttachmentId → route attachments.
  url        String?
  size       Int?         // taille en octets
  mimeType   String?
  latitude   Float?
  longitude  Float?
  type       DocumentType @default(DOCUMENT)
  uploadedAt DateTime     @default(now())
  // PLAN-ACQ-005D — bridge Cloudinary authenticated (pas de re-upload)
  storagePublicId               String?
  sourceAcquisitionAttachmentId String? @unique

  // Relations
  worksite Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
  @@map("documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// ASSIGNMENT — Affectation d'une équipe à un chantier pour une journée
// CONTRAINTE CLÉ : @@unique([teamId, date]) → 1 équipe = 1 chantier par jour max
// ═══════════════════════════════════════════════════════════════════════════

model Assignment {
  id            String           @id @default(cuid())
  worksiteId    String
  teamId        String
  date          DateTime         @db.Date  // journée complète — pas d'heure
  status        AssignmentStatus @default(PENDING)
  refusalReason String?          // obligatoire si status = REFUSED
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  worksite            Worksite             @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  team                Team                 @relation(fields: [teamId], references: [id])
  employeeAssignments EmployeeAssignment[]
  signature           Signature?

  @@unique([teamId, date]) // CONTRAINTE MÉTIER : 1 équipe ne peut pas être sur 2 chantiers le même jour
  @@index([worksiteId])
  @@index([teamId])
  @@index([date])
  @@index([status])
  @@map("assignments")
}

// Affectation individuelle d'un employé pour une journée donnée
// CONTRAINTE CLÉ : @@unique([employeeId, date]) → 1 employé = 1 chantier par jour max
model EmployeeAssignment {
  id           String   @id @default(cuid())
  assignmentId String
  employeeId   String   // pointe vers Employee (pas User)
  date         DateTime @db.Date  // dupliqué depuis Assignment pour la contrainte unique
  createdAt    DateTime @default(now())

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date]) // CONTRAINTE MÉTIER : 1 employé ne peut pas être sur 2 chantiers le même jour
  @@index([employeeId])
  @@index([assignmentId])
  @@index([date])
  @@map("employee_assignments")
}

// ═══════════════════════════════════════════════════════════════════════════
// EXTENSION — Trace chaque prolongation d'un chantier
// ═══════════════════════════════════════════════════════════════════════════

model Extension {
  id              String   @id @default(cuid())
  worksiteId      String
  previousEndDate DateTime // date de fin avant prolongation
  newEndDate      DateTime // nouvelle date de fin après prolongation
  reason          String?
  createdById     String   // userId de celui qui a prolongé
  createdAt       DateTime @default(now())

  // Relations
  worksite Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
  @@map("extensions")
}

// ═══════════════════════════════════════════════════════════════════════════
// ABSENCE — Gestion des absences employé (V1 optionnel, prévu pour V2)
// ═══════════════════════════════════════════════════════════════════════════

model Absence {
  id           String        @id @default(cuid())
  employeeId   String
  companyId    String
  createdById  String?
  type         AbsenceType   @default(OTHER)
  status       AbsenceStatus @default(PENDING)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  reason       String?
  refusalNote  String?
  approvedById String?       // userId du validateur
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId],  references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@index([startDate])
  @@index([status])
  @@map("absences")
}

// ═══════════════════════════════════════════════════════════════════════════
// HISTORY LOG — Audit trail complet de toutes les actions importantes
// oldValue / newValue en JSON pour tracer les diffs avant/après
// ═══════════════════════════════════════════════════════════════════════════

model HistoryLog {
  id         String        @id @default(cuid())
  companyId  String?
  worksiteId String?
  actorId    String        // userId de celui qui a effectué l'action
  action     HistoryAction
  entityType String?       // "Worksite" | "Team" | "Assignment" | "Employee" | ...
  entityId   String?       // id de l'entité concernée
  detail     String?       // description lisible humainement
  oldValue   Json?         // état de l'entité avant modification
  newValue   Json?         // état de l'entité après modification
  createdAt  DateTime      @default(now())

  // Relations
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  worksite Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
  actor    User      @relation("HistoryActor", fields: [actorId], references: [id])

  @@index([companyId])
  @@index([worksiteId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("history_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICATION — Notifications internes in-app
// ═══════════════════════════════════════════════════════════════════════════

model Notification {
  id        String           @id @default(cuid())
  userId    String
  companyId String?
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  readAt    DateTime?
  link      String?          // URL relative vers la ressource concernée
  metadata  Json?            // données contextuelles (ids, noms, etc.)
  createdAt DateTime         @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// INVITATION — Invitation par email (pas d'inscription libre)
// ═══════════════════════════════════════════════════════════════════════════

model Invitation {
  id          String           @id @default(cuid())
  email       String
  role        Role
  companyId   String
  invitedById String           // userId de l'admin qui a invité
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         // calculé à la création (ex: now + 24h)
  acceptedAt  DateTime?        // renseigné quand le compte est créé
  createdAt   DateTime         @default(now())

  // Relations
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([companyId])
  @@index([status])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════════
// PASSWORD RESET — Réinitialisation sécurisée du mot de passe
// ═══════════════════════════════════════════════════════════════════════════

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime  // durée de validité courte recommandée (15-30 min)
  usedAt    DateTime? // renseigné une fois le mot de passe réinitialisé
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

// ═══════════════════════════════════════════════════════════════════════════
// EXPENSE REPORT — Notes de frais
// ═══════════════════════════════════════════════════════════════════════════

model ExpenseReport {
  id             String          @id @default(cuid())
  employeeId     String
  companyId      String
  date           DateTime        @db.Date
  amount         Float
  category       ExpenseCategory
  description    String
  receiptUrl     String?
  status         ExpenseStatus   @default(PENDING)
  rejectionNote  String?
  approvedById   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
  @@map("expense_reports")
}

// ═══════════════════════════════════════════════════════════════════════════
// TIMECLOCK — Pointage géolocalisé (arrivée / départ)
// ═══════════════════════════════════════════════════════════════════════════

model Timeclock {
  id           String    @id @default(cuid())
  employeeId   String
  companyId    String
  worksiteId   String?   // chantier associé (détecté par proximité ou choisi)
  date         DateTime  @db.Date
  checkInAt    DateTime?
  checkInLat   Float?
  checkInLng   Float?
  checkOutAt   DateTime?
  checkOutLat  Float?
  checkOutLng  Float?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worksite  Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([companyId])
  @@index([date])
  @@map("timeclocks")
}

// ═══════════════════════════════════════════════════════════════════════════
// DAILY REPORT — Rapport journalier rempli par le chef d'équipe
// ═══════════════════════════════════════════════════════════════════════════

model DailyReport {
  id          String           @id @default(cuid())
  worksiteId  String
  teamId      String
  createdById String
  date        DateTime         @db.Date
  weather     WeatherCondition @default(SUNNY)
  description String
  issues      String?
  hoursWorked Float            @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  worksite  Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id])
  createdBy Employee @relation(fields: [createdById], references: [id])

  @@unique([teamId, date])
  @@index([worksiteId])
  @@index([teamId])
  @@index([date])
  @@index([createdById])
  @@map("daily_reports")
}

// ═══════════════════════════════════════════════════════════════════════════
// SIGNATURE — Signature électronique de la feuille de présence
// Liée à une affectation (1-to-1), signée par le chef d'équipe
// ═══════════════════════════════════════════════════════════════════════════

model Signature {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  signedById   String   // employeeId of the team leader who signed
  signatureUrl String   // Cloudinary URL of the signature image
  signedAt     DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  signedBy   Employee   @relation(fields: [signedById], references: [id])

  @@index([assignmentId])
  @@index([signedById])
  @@map("signatures")
}

// ═══════════════════════════════════════════════════════════════════════════
// ACCOMMODATION — Logement réservé pour une équipe
// ═══════════════════════════════════════════════════════════════════════════

model Accommodation {
  id           String              @id @default(cuid())
  companyId    String
  teamId       String
  createdById  String              // userId de l'admin qui a créé

  status       AccommodationStatus @default(UPCOMING)

  startDate    DateTime            @db.Date
  endDate      DateTime            @db.Date

  address      String
  city         String?
  zipCode      String?

  doorCode     String?
  contactName  String?
  contactPhone String?

  notes        String?

  // Source & référence externe
  /// Numéro de réservation Booking.com (métier). Ne jamais y stocker un id Gmail technique.
  /// Unicité tenant-safe : @@unique([companyId, bookingReference]).
  bookingReference     String?
  /// Identité technique du message Gmail source (tenant-safe). Null si création manuelle / hors Gmail.
  gmailSourceMessageId String?
  source               String? @default("manual") // "manual" | "gmail-scan" | "n8n" | "agent"

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team     Team    @relation(fields: [teamId], references: [id])

  @@unique([companyId, bookingReference])
  @@unique([companyId, gmailSourceMessageId])
  @@index([companyId])
  @@index([teamId])
  @@index([startDate])
  @@index([bookingReference])
  @@index([status])
  @@map("accommodations")
}

// ═══════════════════════════════════════════════════════════════════════════
// GMAIL CONNECTION — OAuth tokens Gmail par entreprise
// ═══════════════════════════════════════════════════════════════════════════

model GmailConnection {
  id            String   @id @default(cuid())
  companyId     String   @unique
  gmailAddress  String
  accessToken   String   // chiffré AES-256-GCM
  refreshToken  String   // chiffré AES-256-GCM
  tokenExpiry   DateTime
  connectedById String
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}

// PLAN-ACQ-MULTI-GMAIL-001 — Connexions Gmail multi-compte dédiées Acquisition.
// Isolé de gmail_connections (Booking) : aucun upsert partagé.
model AcquisitionGmailConnection {
  id            String   @id @default(cuid())
  companyId     String
  gmailAddress  String
  accessToken   String // chiffré AES-256-GCM
  refreshToken  String // chiffré AES-256-GCM
  tokenExpiry   DateTime
  connectedById String
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  active        Boolean  @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, gmailAddress])
  @@index([companyId, active])
  @@map("acquisition_gmail_connections")
}

// ═══════════════════════════════════════════════════════════════════════════
// PROCESSED GMAIL MESSAGE — Suivi cycle de vie emails Booking (pas Acquisition)
// ═══════════════════════════════════════════════════════════════════════════

model ProcessedGmailMessage {
  id        String @id @default(cuid())
  companyId String
  messageId String

  /// Instant de première observation (lignes historiques : date d'insertion initiale).
  processedAt DateTime @default(now())

  status BookingGmailMessageStatus @default(SUCCEEDED)

  attemptCount   Int       @default(0)
  firstAttemptAt DateTime?
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  succeededAt    DateTime?

  errorCode    String?
  errorMessage String?

  resultType     BookingGmailResultType?
  resultEntityId String?

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, messageId])
  @@index([companyId])
  @@index([status, nextRetryAt])
  @@index([status, lastAttemptAt])
  @@map("processed_gmail_messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// PENDING ACCOMMODATION — Réservation détectée, en attente d'attribution équipe
// ═══════════════════════════════════════════════════════════════════════════

model PendingAccommodation {
  id              String                     @id @default(cuid())
  companyId       String
  /// Id Gmail technique UNIQUEMENT. Null pour N8N / agent (jamais bookingReference).
  gmailMessageId  String?
  /// Clé d'idempotence pending : gmail:{id} | n8n:{ref} | agent:{eventId|ref}
  /// Borne applicative : IDEMPOTENCY_KEY_MAX_BYTES (512 octets UTF-8).
  idempotencyKey  String
  sourceKind      PendingAccommodationSourceKind
  /// Id externe non-Gmail. N8N = bookingReference. Agent = bookingReference si fournie (jamais un event id générique).
  externalSourceId String?

  propertyName    String?
  address         String?
  city            String?
  zipCode         String?
  startDate       DateTime?                  @db.Date
  endDate         DateTime?                  @db.Date
  doorCode        String?
  contactName     String?
  contactPhone    String?
  notes           String?
  rawEmailSnippet String?

  status          PendingAccommodationStatus @default(PENDING)
  accommodationId String?
  confirmedById   String?
  confirmedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, gmailMessageId])
  @@index([companyId])
  @@index([status])
  @@index([companyId, sourceKind, externalSourceId])
  @@map("pending_accommodations")
}

model Truck {
  id          String    @id @default(cuid())
  matricule   String
  marque      String?
  // V1C : modèle du véhicule (optionnel). `marque` est conservée telle quelle (anciennes valeurs « marque modèle » intactes).
  modele      String?
  companyId   String
  teamId      String?   @unique
  chauffeurId String?
  // Archivage (V1A : schéma seulement). CHECK SQL : un véhicule archivé n'a ni équipe ni chauffeur.
  active      Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Restrict : supprimer une entreprise ne doit jamais effacer silencieusement ses véhicules.
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  team        Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  chauffeur   Employee?         @relation("TruckChauffeur", fields: [chauffeurId], references: [id], onDelete: SetNull)
  assignments TruckAssignment[]

  // V2 : projection reconstruisible du journal. NULL = compteur inconnu, jamais zéro implicite.
  currentMileage        Int?
  currentMileageEntryId String?
  mileageRevision       Int     @default(0)
  mileageEntries        MileageEntry[] @relation("TruckMileageEntries")
  mileageTrips          MileageTrip[]  @relation("TruckMileageTrips")
  maintenancePlan       VehicleMaintenancePlan?
  maintenanceEntries    VehicleMaintenanceEntry[]
  currentMileageEntry   MileageEntry? @relation("TruckCurrentMileage", fields: [currentMileageEntryId, id, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "trucks_current_mileage_entry_fkey")

  @@unique([id, companyId])
  @@unique([currentMileageEntryId, id, companyId], map: "trucks_current_mileage_entry_truck_company_key")
  @@unique([matricule, companyId])
  @@index([companyId])
  @@index([chauffeurId])
  @@map("trucks")

  // Véhicules V3 — ajouts des lots isolés.
  vehicleExpenses VehicleExpense[]
  tours VehicleTour[]
  addressImports        VehicleAddressImport[]
  vehicleDocuments         VehicleDocument[]
  vehicleDocumentVersions  VehicleDocumentVersion[]
  vehicleDocumentReminders VehicleDocumentReminder[]
}

// Entretien V2 : journal séparé du kilométrage ; les interventions ne changent pas le compteur.
model VehicleMaintenancePlan {
  id                    String   @id @default(cuid())
  companyId             String
  truckId               String
  intervalKm            Int?
  intervalMonths        Int?
  revision              Int      @default(1)
  updatedAt             DateTime @updatedAt
  updatedById           String
  updatedByNameSnapshot String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  truck     Truck   @relation(fields: [truckId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User    @relation("MaintenancePlanAuthor", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([truckId, companyId])
  @@index([companyId])
  @@map("vehicle_maintenance_plans")
}

model VehicleMaintenanceEntry {
  id                    String   @id @default(cuid())
  companyId             String
  truckId               String
  kind                  String
  occurredAt            DateTime
  mileage               Int
  notes                 String?
  createdById           String
  createdByNameSnapshot String
  recordedAt            DateTime @default(now())
  idempotencyKey        String
  supersedesEntryId     String? @unique
  correctionReason      String?
  supersedes VehicleMaintenanceEntry? @relation("MaintenanceCorrections", fields: [supersedesEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict)
  corrections VehicleMaintenanceEntry[] @relation("MaintenanceCorrections")
  requestHash           String

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  truck     Truck   @relation(fields: [truckId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User    @relation("MaintenanceAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, truckId, idempotencyKey])
  @@index([companyId, truckId, occurredAt])
  @@map("vehicle_maintenance_entries")

  // Véhicules V3 — ajouts des lots isolés.
  documentVersions VehicleDocumentVersion[] @relation("VehicleDocumentMaintenanceEntry")
  @@unique([id, truckId, companyId], map: "vehicle_maintenance_entries_id_truck_company_key")
  expenses VehicleExpense[] @relation("VehicleExpenseMaintenance")
}

enum MileageEntryKind {
  READING
  DEPARTURE
  ARRIVAL
  CORRECTION
}

// V2 : journal immuable (SQL refuse UPDATE/DELETE). Une correction garde la date
// et le contexte de sa racine ; seul le kilométrage effectif change.
model MileageEntry {
  id                    String           @id @default(cuid())
  companyId             String
  truckId               String
  kind                  MileageEntryKind
  mileage               Int
  revision              Int
  occurredAt            DateTime?        @db.Timestamptz(3)
  recordedAt            DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  createdById           String
  createdByNameSnapshot String
  rootEntryId           String?
  supersedesEntryId     String?
  correctionReason      String?          @db.Text
  idempotencyKey        String           @db.Uuid
  requestHash           String           @db.Char(64)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  truck     Truck   @relation("TruckMileageEntries", fields: [truckId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy User    @relation("MileageAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  rootEntry       MileageEntry?  @relation("MileageRoot", fields: [rootEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "mileage_entries_root_truck_company_fkey")
  corrections     MileageEntry[] @relation("MileageRoot")
  supersedesEntry MileageEntry?  @relation("MileageCorrectionChain", fields: [supersedesEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "mileage_entries_supersedes_truck_company_fkey")
  successor       MileageEntry?  @relation("MileageCorrectionChain")

  tripStarted     MileageTrip? @relation("MileageTripStart")
  tripEnded       MileageTrip? @relation("MileageTripEnd")
  currentForTruck Truck?       @relation("TruckCurrentMileage")

  @@unique([id, truckId, companyId], map: "mileage_entries_id_truck_company_key")
  @@unique([supersedesEntryId, truckId, companyId], map: "mileage_entries_supersedes_truck_company_key")
  @@unique([companyId, truckId, revision], map: "mileage_entries_company_truck_revision_key")
  @@unique([companyId, truckId, idempotencyKey], map: "mileage_entries_company_truck_idempotency_key")
  @@index([companyId, truckId, occurredAt], map: "mileage_entries_company_truck_occurred_idx")
  @@index([rootEntryId, truckId, companyId], map: "mileage_entries_root_truck_company_idx")
  @@index([createdById])
  @@map("mileage_entries")
}

// V2 : contexte figé AU DÉPART. Ouvert = endEntryId NULL ; distance calculée
// depuis les valeurs effectives des deux racines. Aucun statut/distance redondant.
model MileageTrip {
  id                    String  @id @default(cuid())
  companyId             String
  truckId               String
  startEntryId          String
  endEntryId            String?
  worksiteId            String?
  teamId                String?
  chauffeurId           String?
  worksiteNameSnapshot  String?
  teamNameSnapshot      String?
  chauffeurNameSnapshot String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  truck     Truck   @relation("TruckMileageTrips", fields: [truckId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  startEntry MileageEntry  @relation("MileageTripStart", fields: [startEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "mileage_trips_start_truck_company_fkey")
  endEntry   MileageEntry? @relation("MileageTripEnd", fields: [endEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "mileage_trips_end_truck_company_fkey")
  worksite   Worksite? @relation("MileageWorksite", fields: [worksiteId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  team       Team?     @relation("MileageTeam", fields: [teamId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  chauffeur  Employee? @relation("MileageDriver", fields: [chauffeurId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([startEntryId, truckId, companyId], map: "mileage_trips_start_truck_company_key")
  @@unique([endEntryId, truckId, companyId], map: "mileage_trips_end_truck_company_key")
  // Un seul trajet ouvert : index partiel SQL mileage_trips_v2_open_truck_key.
  @@index([companyId, truckId])
  @@index([worksiteId, companyId])
  @@index([teamId, companyId])
  @@index([chauffeurId, companyId])
  @@map("mileage_trips")

  // Véhicules V3 — ajouts des lots isolés.
  @@unique([id, truckId, companyId], map: "mileage_trips_id_truck_company_key")
  tour VehicleTour?
  @@unique([id, truckId, companyId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ASSISTANT CONSULTATIONS — Fondation acquisition d'emails (inactif par défaut)
// Email entrant → AcquisitionMessage (idempotent) → WorksiteImportDraft.
// Aucun connecteur Gmail, aucun appel IA, aucune création de chantier dans
// cette phase. Activation future via PLANIFICATOR_ACQUISITION_ENABLED.
// ═══════════════════════════════════════════════════════════════════════════

model AcquisitionMessage {
  id                 String                   @id @default(cuid())
  companyId          String
  source             AcquisitionSource
  externalMessageId  String
  /// Identité boîte stable (connectionId Acquisition) — "" = legacy mono-boîte.
  sourceMailboxKey   String                   @default("")
  /// Gmail thread id (Lot H) — indexé pour regroupement / observabilité.
  threadId           String?
  /// Partenaire résolu à l’ingestion (Lot I) — null si REJECTED.
  resolvedPartnerId  String?
  senderEmail        String
  senderDomain       String
  subject            String
  receivedAt         DateTime
  status             AcquisitionMessageStatus @default(RECEIVED)
  processingAttempts Int                      @default(0)
  lastErrorCode      String?
  lastErrorMessage   String?
  rawMetadata        Json?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resolvedPartner  AcquisitionPartner?      @relation(fields: [resolvedPartnerId], references: [id], onDelete: SetNull)
  draft            WorksiteImportDraft?
  attachments      AcquisitionAttachment[]
  content          AcquisitionMessageContent?
  contentFetchState AcquisitionContentFetchState?

  // Idempotence par tenant + boîte : le même id Gmail peut exister sur deux
  // boîtes du même tenant sans collision.
  @@unique([companyId, source, sourceMailboxKey, externalMessageId])
  // Cible des FK composites (draft, attachments) : garantit EN BASE que
  // l'enfant porte le même companyId que son message (anti inter-tenant).
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, receivedAt])
  @@index([companyId, threadId])
  @@index([companyId, resolvedPartnerId])
  @@index([companyId, sourceMailboxKey])
  @@map("acquisition_messages")
}

// PLAN-ACQ-005A — Contenu email normalisé (jamais MIME/body.data/HTML brut).
model AcquisitionMessageContent {
  id                   String   @id @default(cuid())
  companyId            String
  acquisitionMessageId String   @unique
  normalizedText       String   @db.Text
  contentHash          String
  sourceMimeType       String?
  sourceCharset        String?
  hadHtml              Boolean  @default(false)
  byteLengthOriginal   Int      @default(0)
  fetchedAt            DateTime
  sanitizedAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // FK composite anti inter-tenant (même pattern que draft / attachments).
  acquisitionMessage AcquisitionMessage @relation(fields: [acquisitionMessageId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([acquisitionMessageId, companyId])
  @@index([companyId])
  @@map("acquisition_message_contents")
}

// PLAN-ACQ-OPS-003 — État retry / poison pill du fetch content (additif).
// terminalAt non null ⇒ exclu de la file worker.
// Colonnes previousTerminal*/reactivated* : réservées reset non destructif (runbook RB-PLAN-ACQ-003), non écrites par le runtime OPS-003.
// id : TEXT opaque. Le défaut Prisma cuid() n’est pas utilisé par le repository OPS-003
// (INSERT raw SQL avec crypto.randomUUID()). Aucune logique métier ne dépend du format.
model AcquisitionContentFetchState {
  id                        String    @id @default(cuid())
  companyId                 String
  acquisitionMessageId      String    @unique
  attemptCount              Int       @default(0)
  lastErrorCode             String?
  lastErrorAt               DateTime?
  nextRetryAt               DateTime?
  terminalAt                DateTime?
  previousTerminalAt        DateTime?
  previousTerminalErrorCode String?
  reactivatedAt             DateTime?
  reactivatedBy             String?
  reactivationReason        String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  acquisitionMessage AcquisitionMessage @relation(fields: [acquisitionMessageId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([acquisitionMessageId, companyId])
  @@index([companyId, terminalAt, nextRetryAt])
  @@map("acquisition_content_fetch_states")
}

model WorksiteImportDraft {
  id                   String                    @id @default(cuid())
  companyId            String
  acquisitionMessageId String                    @unique
  status               WorksiteImportDraftStatus @default(PENDING_EXTRACTION)
  proposedClientId     String?
  proposedClientName   String?
  proposedWorksiteName String?
  proposedAddress      String?
  proposedPostalCode   String?
  proposedCity         String?
  proposedContactName  String?
  proposedContactEmail String?
  proposedContactPhone String?
  proposedStartDate    DateTime?
  proposedEndDate      DateTime?
  /// Date métier d’émission / datation de la consultation client (≠ receivedAt, ≠ dates chantier).
  clientConsultationDate DateTime?
  proposedDescription  String?
  extractedData        Json?
  confidenceData       Json?
  // PLAN-ACQ-005B — warnings catalogués (pas de texte provider libre)
  warningData          Json?
  version              Int                       @default(0)
  extractionStartedAt  DateTime?
  extractionCompletedAt DateTime?
  contentHashAtExtraction String?
  extractionSchemaVersion String?
  extractionAttemptCount  Int                    @default(0)
  extractionProvider   String?
  extractionModel      String?
  lastExtractionErrorCode String?
  lastExtractionErrorAt   DateTime?
  /// PLAN-ACQ-DETECTION-001 — preuve Detection liée au contentHash (NULL = historique inconnu / fail-closed).
  detectionClassification AcquisitionConsultationClassification?
  detectionContentHash    String?
  detectionCompletedAt    DateTime?
  /// PLAN-ACQ-DETECTION-001 — retry AUTO extraction (NULL = historique / fail-closed).
  extractionRetryable     Boolean?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  rejectionReason      String?
  createdWorksiteId    String?                   @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // FK composite (acquisitionMessageId, companyId) → (id, companyId) :
  // la base REFUSE un brouillon dont le companyId diffère de celui du message.
  acquisitionMessage AcquisitionMessage @relation(fields: [acquisitionMessageId, companyId], references: [id, companyId], onDelete: Cascade)
  proposedClient     Client?            @relation(fields: [proposedClientId], references: [id], onDelete: SetNull)
  reviewedBy         User?              @relation("ImportDraftReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdWorksite    Worksite?          @relation(fields: [createdWorksiteId], references: [id], onDelete: SetNull)

  // Requis par Prisma pour la relation 1-1 composite ; l'unicité simple sur
  // acquisitionMessageId (plus forte) reste la garantie métier du 1-1.
  @@unique([acquisitionMessageId, companyId])
  @@index([companyId, status])
  @@map("worksite_import_drafts")
}

/// PLAN-ACQ-V2 Lot F — Journal des décisions auto-approve / auto-convert / human.
model AcquisitionDecisionJournal {
  id             String   @id @default(cuid())
  companyId      String
  draftId        String
  decisionCode   String
  reasons        Json
  scores         Json
  actorUserId    String?
  metadata       Json?
  /// PLAN-ACQ-AGENTS-LOT-3D/3E-CORRECTION-4A — clé d’idempotence atomique (nullable = legacy).
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, draftId])
  @@index([companyId, decisionCode])
  @@map("acquisition_decision_journals")
}

model AcquisitionAttachment {
  id                   String                        @id @default(cuid())
  companyId            String
  acquisitionMessageId String
  // Identité STABLE de la pièce jointe dans son message, calculée par le
  // service : "ext:<externalAttachmentId>" si fourni, sinon "part:<partId>"
  // (partie MIME), sinon "ord:<position>" (ordinal stable). Jamais le seul
  // filename. Garantit l'idempotence même sans identifiant Gmail exploitable.
  attachmentKey        String
  externalAttachmentId String?
  filename             String
  mimeType             String
  sizeBytes            Int
  category             AcquisitionAttachmentCategory @default(UNKNOWN)
  status               AcquisitionAttachmentStatus   @default(DISCOVERED)
  storageUrl           String?
  storagePublicId      String?
  sha256               String?
  storedAt             DateTime?
  lastErrorCode        String?
  lastErrorAt          DateTime?
  // PLAN-ACQ-004D — reclaim / retry (pas d'historique attempts séparé en V1)
  downloadClaimedAt    DateTime?
  downloadRetryCount   Int                           @default(0)
  downloadNextRetryAt  DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // FK composite : même garantie anti inter-tenant que pour les brouillons.
  acquisitionMessage AcquisitionMessage @relation(fields: [acquisitionMessageId, companyId], references: [id, companyId], onDelete: Cascade)
  accessLogs         AcquisitionAttachmentAccessLog[]

  @@unique([id, companyId])
  @@unique([acquisitionMessageId, attachmentKey])
  @@index([companyId])
  @@index([acquisitionMessageId])
  @@index([companyId, status, createdAt])
  @@index([status, downloadClaimedAt])
  @@index([companyId, status, downloadNextRetryAt])
  @@map("acquisition_attachments")
}

model AcquisitionAttachmentAccessLog {
  id                    String                             @id @default(cuid())
  companyId             String
  attachmentId          String?
  requestedAttachmentId String
  userId                String
  action                AcquisitionAttachmentAccessAction
  outcome               AcquisitionAttachmentAccessOutcome
  reasonCode            String?
  createdAt             DateTime                           @default(now())

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment AcquisitionAttachment? @relation(fields: [attachmentId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, requestedAttachmentId, createdAt])
  @@index([userId, createdAt])
  @@map("acquisition_attachment_access_logs")
}

// Curseur de synchronisation mail par tenant, source et boîte (connectionId).
// Aucun token OAuth — uniquement watermark de reprise.
// mailboxKey = "" : legacy mono-boîte ; sinon = AcquisitionGmailConnection.id.
model AcquisitionScanCursor {
  id                  String            @id @default(cuid())
  companyId           String
  source              AcquisitionSource
  mailboxKey          String            @default("")
  lastHistoryId       String?
  lastSyncedAt        DateTime?
  consecutiveFailures Int               @default(0)
  lastErrorCode       String?
  lastErrorAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, source, mailboxKey])
  @@index([companyId, source])
  @@map("acquisition_scan_cursors")
}

// ═══════════════════════════════════════════════════════════════════════════
// PLAN-ACQ-012-LOT-1.1 — Registre Sources d'acquisition (partenaires)
// Structure seule. Bootstrap lauralu.fr → LOT-1.2. Gate runtime → LOT-1.4.
// Ne pas confondre avec l'enum AcquisitionSource (canal Gmail / futur Outlook).
// ═══════════════════════════════════════════════════════════════════════════

model AcquisitionPartner {
  id         String            @id @default(cuid())
  companyId  String
  name       String
  // Code interne stable par tenant (slug) — ex. "lauralu" (donnée, pas constante pipeline)
  code       String
  // Canal connecteur : enum existant AcquisitionSource (GMAIL V1) — pas un nouveau type
  connector  AcquisitionSource @default(GMAIL)
  // Clé technique contrôlée (V1: "consultations") — pas une chaîne libre utilisateur
  pipeline   String            @default("consultations")
  active     Boolean           @default(true)
  /// Priorité relative (plus petit = plus prioritaire) — Lot I
  priority   Int               @default(100)
  /// Si true : domaine seul insuffisant, email allowlist obligatoire
  requireExactEmail  Boolean   @default(false)
  /// Politique auto (Lot I / F) — défaut OFF (revue humaine)
  autoApproveEnabled Boolean   @default(false)
  autoConvertEnabled Boolean   @default(false)
  /// Autorise création client NEW en auto-convert — défaut OFF (R2)
  allowCreateClient  Boolean   @default(false)
  /// Seuil confiance [0..1] ; null = fallback env global
  minConfidence      Float?
  /// PLAN-ACQ-CONSULTATIONS-FIX-001 — Client Planificator déterministe (nullable)
  clientId           String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  company  Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// FK composite tenant-safe. onDelete Restrict : companyId est NOT NULL —
  /// une politique SetNull sur FK composite est incompatible ; un Client
  /// référencé ne peut pas être supprimé tant qu’un Partner le pointe.
  client   Client?                     @relation(fields: [clientId, companyId], references: [id, companyId], onDelete: Restrict)
  domains  AcquisitionPartnerDomain[]
  emails   AcquisitionPartnerEmail[]
  messages AcquisitionMessage[]

  @@unique([companyId, code])
  // Cible FK composite domaines → partenaire (anti inter-tenant)
  @@unique([id, companyId])
  @@index([companyId, active])
  @@index([companyId, priority])
  @@index([companyId, clientId])
  @@map("acquisition_partners")
}

model AcquisitionPartnerDomain {
  id               String   @id @default(cuid())
  companyId        String
  partnerId        String
  // Domaine normalisé (lowercase, exact) — ex. "lauralu.fr"
  domainNormalized String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // FK composite : le domaine ne peut pas pointer un partenaire d'un autre tenant
  partner AcquisitionPartner @relation(fields: [partnerId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, domainNormalized])
  @@index([companyId, active])
  @@index([partnerId])
  @@map("acquisition_partner_domains")
}

/// PLAN-ACQ-V2 Lot I — Adresses email autorisées (allowlist optionnelle par partenaire).
model AcquisitionPartnerEmail {
  id              String   @id @default(cuid())
  companyId       String
  partnerId       String
  emailNormalized String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner AcquisitionPartner @relation(fields: [partnerId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, emailNormalized])
  @@unique([id, companyId])
  @@index([companyId, active])
  @@index([partnerId])
  @@map("acquisition_partner_emails")
}

// PLAN-ACQ-V2-001 — Lease durable multi-instance (Neon / Vercel).
// Verrou nommé global : pas de FK tenant. ownerRunId null = libre.
model AcquisitionOrchestratorLease {
  key            String    @id
  ownerRunId     String?
  leaseExpiresAt DateTime?
  acquiredAt     DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([leaseExpiresAt])
  @@map("acquisition_orchestrator_leases")
}

// Motif d'ouverture d'une période TruckAssignment (renseigné à partir de V1B).
enum TruckAssignmentReason {
  CREATED
  REASSIGNED
  DISPLACED
  ARCHIVED
  RESTORED
  BACKFILL
}

// Historique des affectations camion : qui conduisait quel camion, dans
// quelle équipe, sur quelle période. Une ligne ouverte (endedAt null) =
// affectation en cours. Permet de retrouver le chauffeur d'un camion à
// une date donnée (amendes, infractions, accidents).
model TruckAssignment {
  id             String                 @id @default(cuid())
  truckId        String
  chauffeurId    String?
  teamId         String?
  companyId      String
  startedAt      DateTime               @default(now())
  endedAt        DateTime?
  /// Motif de la période (V1B). Jamais NULL en base après V1B-db (CHECK truck_assignments_v1b_reason_required_check) ;
  /// les lignes antérieures à V1B valent BACKFILL.
  reason         TruckAssignmentReason?
  /// = truckId tant que la période est ouverte (endedAt IS NULL), sinon NULL.
  /// Maintenu exclusivement par le trigger SQL truck_assignments_v1a_open_for_truck_id
  /// (migration 20261006120000_vehicles_v1a_foundation) ; ne jamais l'écrire depuis l'application.
  /// L'unicité garantit au plus une période ouverte par véhicule.
  openForTruckId String?                @unique

  // Restrict (V1B-db) : une référence historique non NULL n'est jamais effacée silencieusement
  // par la suppression de son entreprise, de son véhicule, de son chauffeur ou de son équipe.
  // chauffeurId / teamId restent nullables : NULL = période sans chauffeur / sans équipe.
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  truck     Truck     @relation(fields: [truckId], references: [id], onDelete: Restrict)
  chauffeur Employee? @relation("TruckAssignmentChauffeur", fields: [chauffeurId], references: [id], onDelete: Restrict)
  team      Team?     @relation("TruckAssignmentTeam", fields: [teamId], references: [id], onDelete: Restrict)

  @@index([truckId, startedAt])
  @@index([chauffeurId])
  @@index([companyId])
  @@map("truck_assignments")
}

// ═══════════════════════════════════════════════════════════════════════════
// INTEGRATION PLATFORM — LOT-1B1 — IntegrationConnection
// Table générique multi-tenant. Aucun secret en clair. Aucune FK Booking/ACQ.
// ═══════════════════════════════════════════════════════════════════════════

model IntegrationConnection {
  id                  String                      @id @default(cuid())
  companyId           String
  connectorType       String
  displayName         String
  status              IntegrationConnectionStatus
  credentialStatus    IntegrationCredentialStatus @default(MISSING)
  runtimeHealth       IntegrationRuntimeHealth    @default(UNKNOWN)
  secretBackend       IntegrationSecretBackend
  credentialsRef      String?
  config              Json
  watermark           String?
  lastSuccessfulRunAt DateTime?
  lastFailedRunAt     DateTime?
  lastHealthCheckAt   DateTime?
  lastStableErrorCode String?
  schemaVersion       String                      @default("1.0.0")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inboundEnvelopes InboundEnvelope[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, connectorType])
  @@map("integration_connections")
}

// ═══════════════════════════════════════════════════════════════════════════
// INTEGRATION PLATFORM — LOT-1B2 — InboundEnvelope + NormalizedInbound
// Additive. Convention colonnes camelCase (alignée LOT-1B1).
// ═══════════════════════════════════════════════════════════════════════════

model InboundEnvelope {
  id               String                  @id @default(cuid())
  companyId        String
  connectionId     String
  connectorType    String
  externalId       String
  idempotencyKey   String
  receivedAt       DateTime
  payloadRef       String
  contentType      String
  schemaVersion    String                  @default("1.0.0")
  lifecycleStatus  EnvelopeLifecycleStatus @default(RECEIVED)
  rawPayloadHash   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection         IntegrationConnection @relation(fields: [connectionId, companyId], references: [id, companyId], onDelete: Cascade, map: "integration_inbound_envelopes_connectionId_companyId_fkey")
  normalizedInbounds NormalizedInbound[]

  @@unique([id, companyId], map: "integration_inbound_envelopes_id_companyId_key")
  @@unique([id, companyId, connectionId], map: "integration_inbound_envelopes_id_companyId_connectionId_key")
  @@unique([companyId, connectionId, idempotencyKey], map: "integration_inbound_envelopes_idempotency_key")
  @@index([companyId, lifecycleStatus], map: "integration_inbound_envelopes_companyId_lifecycleStatus_idx")
  // Noms ≤63 octets (limite PG) — colonnes = SPEC §3.4
  @@index([companyId, connectionId, receivedAt], map: "integration_inbound_envelopes_co_conn_receivedAt_idx")
  @@index([companyId, connectionId, externalId], map: "integration_inbound_envelopes_co_conn_externalId_idx")
  @@map("integration_inbound_envelopes")
}

model NormalizedInbound {
  id             String        @id @default(cuid())
  companyId      String
  connectionId   String
  envelopeId     String
  family         InboundFamily
  occurredAt     DateTime
  receivedAt     DateTime
  normalizedHash String
  artifactRefs   String[]      @default([])
  schemaVersion  String        @default("1.0.0")
  message        Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  envelope InboundEnvelope @relation(fields: [envelopeId, companyId, connectionId], references: [id, companyId, connectionId], onDelete: Cascade, map: "integration_normalized_inbounds_envelope_tenant_connection_fkey")

  @@unique([id, companyId], map: "integration_normalized_inbounds_id_companyId_key")
  @@unique([envelopeId, companyId, family, schemaVersion], map: "integration_normalized_inbounds_envelope_version_key")
  // Nom ≤63 octets (limite PG) — colonnes = SPEC §4.4
  @@index([companyId, connectionId, receivedAt], map: "integration_normalized_inbounds_co_conn_receivedAt_idx")
  @@index([companyId, envelopeId], map: "integration_normalized_inbounds_companyId_envelopeId_idx")
  @@map("integration_normalized_inbounds")
}

// ═══════════════════════════════════════════════════════════════════════════
// TASK — Tâche interne (module Tâches V1)
// Multi-tenant strict : rattachée obligatoirement à une entreprise (companyId).
// `createdById` conserve le userId du créateur comme identifiant scalaire
// historique (même choix que Worksite/Quote/Invoice) : la suppression d'un
// compte n'efface pas l'identité du créateur et ne supprime pas la tâche.
// Références facultatives vers Employee (assigné) et Worksite (chantier),
// désactivées en SetNull pour préserver la tâche lors des suppressions existantes.
// ═══════════════════════════════════════════════════════════════════════════

model Task {
  id          String       @id @default(cuid())
  companyId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?      // employeeId de l'employé assigné (même entreprise)
  worksiteId  String?      // chantier rattaché (même entreprise)
  createdById String       // userId du créateur (identifiant scalaire, sans FK)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  worksite Worksite? @relation(fields: [worksiteId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([assigneeId])
  @@index([worksiteId])
  @@map("tasks")
}

// ═══════════════════════════════════════════════════════════════════════════
// AGENT GATEWAY — PLAN-AGENT-GATEWAY-001 / LOT-1A (ADR-PLAN-001, SPEC §4)
// Migration expand uniquement. Aucune table métier existante modifiée.
// ═══════════════════════════════════════════════════════════════════════════

enum AgentPrincipalStatus {
  ACTIVE
  REVOKED
}

/// Issue d'une requête de la passerelle (journal, SPEC §4.2).
enum AgentAccessOutcome {
  OK
  BAD_REQUEST
  UNAUTHORIZED
  FORBIDDEN
  NOT_FOUND
  RATE_LIMITED
  DISABLED
  BUSY
  TIMEOUT
  ERROR
}

/// Scopes v1 — lecture seule par construction : aucun scope d'écriture n'existe.
/// Correspondance avec les chaînes du contrat (`worksites:read`…) : src/lib/agent-gateway/scopes.ts
enum AgentScope {
  WORKSITES_READ
  EMPLOYEES_READ
  ASSIGNMENTS_READ
  ABSENCES_READ
}

/// Principal agent : identité mono-entreprise d'un agent IA externe. Jamais un User.
model AgentPrincipal {
  id              String               @id @default(cuid())
  companyId       String
  name            String
  tokenHash       String               @unique // SHA-256 hex du jeton complet
  tokenPrefix     String // `plag_` + 7 caractères, identification humaine, non secret
  scopes          AgentScope[]
  status          AgentPrincipalStatus @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime             @default(now())
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?

  // Relations — Restrict : la suppression d'une entreprise ou d'un utilisateur
  // exige la révocation/archivage préalable des principaux (SPEC §13.2).
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("AgentPrincipalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  accessLogs  AgentAccessLog[]
  rateWindows AgentRateWindow[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("agent_principals")
}

/// Journal d'accès : lignes unitaires (principal dans le quota) et lignes agrégées
/// par minute/issue (`aggregateKey`) pour les anonymes et les dépassements de quota.
/// principalId/companyId nullables, aucune cascade : le journal survit au principal.
model AgentAccessLog {
  id                   String             @id @default(cuid())
  principalId          String?
  companyId            String? // dénormalisé, volontairement sans FK
  presentedTokenDigest String? // HMAC du jeton présenté — principal résolu uniquement
  aggregateKey         String?            @unique // anon:<minute>:<outcome> | principal:<id>:<minute>:<outcome>
  count                Int                @default(1)
  tool                 String
  paramsDigest         String?
  outcome              AgentAccessOutcome
  httpStatus           Int
  latencyMs            Int
  correlationId        String
  createdAt            DateTime           @default(now())

  principal AgentPrincipal? @relation(fields: [principalId], references: [id], onDelete: SetNull)

  @@index([principalId, createdAt])
  @@index([companyId, createdAt])
  @@index([presentedTokenDigest, createdAt])
  @@index([createdAt])
  @@map("agent_access_logs")
}

/// Compteur de débit par principal et par minute (SPEC §9). Éphémère : cascade.
model AgentRateWindow {
  principalId String
  windowStart DateTime
  count       Int      @default(0)

  principal AgentPrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@id([principalId, windowStart])
  @@index([windowStart])
  @@map("agent_rate_windows")
}

/// Compteur des tentatives anonymes : clés `all` et `ip:<HMAC>` uniquement —
/// jamais dérivé d'un jeton (état borné, SPEC §9 S2).
model AgentAnonRateWindow {
  keyDigest   String
  windowStart DateTime
  count       Int      @default(0)

  @@id([keyDigest, windowStart])
  @@index([windowStart])
  @@map("agent_anon_rate_windows")
}

/// Kill-switch sans déploiement : ligne unique `singleton`. Absente ⇒ désactivé.
model AgentGatewayControl {
  id              String   @id // valeur fixe "singleton"
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("agent_gateway_control")
}


// ═══════════════════════════════════════════════════════════════════════════
// COMPTABILITÉ — Lot A1 (ADR-PLAN-003, SPEC-ACC-A) : partie double, multi-société.
// Montants en centimes (BigInt). Écritures validées immuables (déclencheurs SQL de la
// migration accounting_a1_engine). Toutes les relations : onDelete Restrict, FK composites
// (companyId, id) pour garantir l'appartenance à la même société.
// ═══════════════════════════════════════════════════════════════════════════

enum FiscalYearStatus {
  OPEN
  CLOSING
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  VALIDATED
}

enum AccountingJournalKind {
  SALES      // VT
  PURCHASES  // HA
  BANK       // BQ
  MISC       // OD
}

model AccountingAccount {
  id        String   @id @default(cuid())
  companyId String
  number    String   // numéro PCG (ex. 411000)
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines   JournalEntryLine[]
  supplierDefaults Supplier[]        // Lot C5
  supplierInvoices SupplierInvoice[] // Lot C5

  @@unique([companyId, number])
  @@unique([companyId, id])
  @@map("accounting_accounts")
}

model AccountingJournal {
  id        String                @id @default(cuid())
  companyId String
  code      String                // VT, HA, BQ, OD
  label     String
  kind      AccountingJournalKind
  createdAt DateTime              @default(now())

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries    JournalEntry[]
  sequences  AccountingSequence[]
  chainHeads AccountingChainHead[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("accounting_journals")
}

model FiscalYear {
  id        String           @id @default(cuid())
  companyId String
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now())

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries   JournalEntry[]
  sequences AccountingSequence[]

  @@unique([companyId, id])
  @@index([companyId, startDate])
  @@map("fiscal_years")
}

model AccountingSequence {
  companyId    String
  journalId    String
  fiscalYearId String
  lastNumber   Int    @default(0)

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journal    AccountingJournal @relation(fields: [companyId, journalId], references: [companyId, id], onDelete: Restrict)
  fiscalYear FiscalYear        @relation(fields: [companyId, fiscalYearId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, journalId, fiscalYearId])
  @@map("accounting_sequences")
}

model AccountingChainHead {
  companyId   String
  journalId   String
  lastEntryId String?
  lastHash    String

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journal AccountingJournal @relation(fields: [companyId, journalId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, journalId])
  @@map("accounting_chain_heads")
}

model JournalEntry {
  id            String             @id @default(cuid())
  companyId     String
  journalId     String
  fiscalYearId  String
  status        JournalEntryStatus @default(DRAFT)
  entryDate     DateTime           @db.Date
  documentDate  DateTime?          @db.Date
  documentRef   String?
  label         String
  closingEntry  Boolean            @default(false)
  number        Int?
  validatedAt   DateTime?
  validatedById String?
  sourceType    String?
  sourceId      String?
  sourceVersion Int?
  sourceHash    String?
  reversalOfId  String?
  prevEntryId   String?
  prevHash      String?
  hash          String?
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journal    AccountingJournal  @relation(fields: [companyId, journalId], references: [companyId, id], onDelete: Restrict)
  fiscalYear FiscalYear         @relation(fields: [companyId, fiscalYearId], references: [companyId, id], onDelete: Restrict)
  reversalOf JournalEntry?      @relation("EntryReversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: Restrict)
  reversedBy JournalEntry[]     @relation("EntryReversal")
  lines      JournalEntryLine[]
  documentPostings AccountingDocumentPosting[] // Lot C5

  @@unique([companyId, id])
  @@unique([companyId, journalId, fiscalYearId, number])
  @@unique([companyId, sourceType, sourceId, sourceVersion])
  @@index([companyId, status])
  @@index([companyId, fiscalYearId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id          String  @id @default(cuid())
  companyId   String
  entryId     String
  accountId   String
  position    Int
  label       String?
  debitCents  BigInt  @default(0)
  creditCents BigInt  @default(0)
  vatRateBp   Int?    // taux de TVA en points de base (2000 = 20 %)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry   JournalEntry      @relation(fields: [companyId, entryId], references: [companyId, id], onDelete: Restrict)
  account AccountingAccount @relation(fields: [companyId, accountId], references: [companyId, id], onDelete: Restrict)

  @@unique([entryId, position])
  @@index([companyId, accountId])
  @@map("journal_entry_lines")
}

model VehicleExpense {
  id                    String                     @id @default(cuid())
  companyId             String
  truckId               String
  category              String
  occurredAt            DateTime                   @db.Timestamptz(3)
  amount                Decimal                    @db.Decimal(14, 2)
  currency              String                     @db.Char(3)
  litres                Decimal?                   @db.Decimal(12, 3)
  mileageObservation    Int?
  supplier              String?
  reference             String?
  receiptFingerprint    String?
  maintenanceEntryId String?
  documentVersionId   String?
  notes                 String?
  status                String                     @default("PENDING")
  revision              Int                        @default(1)
  sourceExpenseReportId String?
  sourceSnapshot        Json?
  createdById           String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
