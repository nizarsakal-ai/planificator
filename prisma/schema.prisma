// ═══════════════════════════════════════════════════════════════════════════
// COMPTABILITÉ — Lot C5 (SPEC-BILLING-C5) : lien pièce ↔ écriture, fournisseurs, factures fournisseurs (OCR), banque,
// déclarations de TVA. Tout porte companyId ; FK Restrict ; FK composites vers les tables comptables A1.
// ═══════════════════════════════════════════════════════════════════════════

model AccountingDocumentPosting {
  id            String   @id @default(cuid())
  companyId     String
  sourceType    String   // INVOICE | CREDIT_NOTE | DEPOSIT | PAYMENT | SUPPLIER_INVOICE
  sourceId      String
  sourceVersion Int      @default(1)
  entryId       String
  createdAt     DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry   JournalEntry @relation(fields: [companyId, entryId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, sourceType, sourceId, sourceVersion])
  @@index([companyId, entryId])
  @@map("accounting_document_postings")
}

model Supplier {
  id                      String   @id @default(cuid())
  companyId               String
  name                    String
  siret                   String?
  vatNumber               String?
  email                   String?
  address                 String?
  defaultExpenseAccountId String?
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company               Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultExpenseAccount AccountingAccount? @relation(fields: [companyId, defaultExpenseAccountId], references: [companyId, id], onDelete: Restrict)
  invoices              SupplierInvoice[]

  @@unique([companyId, id])
  @@unique([companyId, siret])
  @@index([companyId, name])
  @@map("suppliers")
}

enum SupplierInvoiceStatus {
  PENDING
  VALIDATED
  REJECTED
}

model SupplierInvoiceFile {
  id           String   @id @default(cuid())
  companyId    String
  sha256       String
  mime         String
  size         Int
  data         Bytes
  originalName String
  createdAt    DateTime @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices SupplierInvoice[]

  @@unique([companyId, id])
  @@unique([companyId, sha256])
  @@map("supplier_invoice_files")
}

model SupplierInvoice {
  id               String                @id @default(cuid())
  companyId        String
  supplierId       String?
  supplierName     String
  siret            String?
  number           String
  date             DateTime              @db.Date
  dueDate          DateTime?             @db.Date
  totalHTCents     BigInt
  vatCents         BigInt
  totalTTCCents    BigInt
  vatRateBp        Int?
  category         String?
  expenseAccountId String?
  status           SupplierInvoiceStatus @default(PENDING)
  fileId           String?
  ocrProvider      String?
  ocrRaw           Json?
  ocrConfidence    Json?
  validatedAt      DateTime?
  validatedById    String?
  paidAt           DateTime?             @db.Date
  notes            String?
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier       Supplier?            @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict) // Correctif P2-02
  expenseAccount AccountingAccount?   @relation(fields: [companyId, expenseAccountId], references: [companyId, id], onDelete: Restrict)
  file           SupplierInvoiceFile? @relation(fields: [companyId, fileId], references: [companyId, id], onDelete: Restrict) // Correctif P2-02
  bankTransactions BankTransaction[]

  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([companyId, date])
  @@index([companyId, supplierId])
  @@map("supplier_invoices")
}

model BankStatementImport {
  id           String   @id @default(cuid())
  companyId    String
  fileName     String
  sha256       String
  rowCount     Int
  mapping      Json
  importedById String
  createdAt    DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactions BankTransaction[]

  @@unique([companyId, id])
  @@unique([companyId, sha256])
  @@map("bank_statement_imports")
}

enum BankTransactionStatus {
  PENDING
  MATCHED
  IGNORED
}

model BankTransaction {
  id                       String                @id @default(cuid())
  companyId                String
  importId                 String
  date                     DateTime              @db.Date
  label                    String
  amountCents              BigInt
  reference                String?
  fingerprint              String
  status                   BankTransactionStatus @default(PENDING)
  matchedInvoiceId         String?
  matchedPaymentId         String?
  matchedSupplierInvoiceId String?
  matchedAt                DateTime?
  notes                    String?
  createdAt                DateTime              @default(now())
  // Correctif P2-01 : identité d'une opération (identifiant bancaire stable, rang d'occurrence du même tuple, ambiguïté).
  externalId               String?
  occurrence               Int                   @default(1)
  identityAmbiguous        Boolean               @default(false)

  company                Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  import                 BankStatementImport @relation(fields: [companyId, importId], references: [companyId, id], onDelete: Restrict) // Correctif P2-02
  matchedInvoice         Invoice?            @relation("BankMatchedInvoice", fields: [companyId, matchedInvoiceId], references: [companyId, id], onDelete: Restrict)
  matchedPayment         InvoicePayment?     @relation("BankMatchedPayment", fields: [companyId, matchedPaymentId], references: [companyId, id], onDelete: Restrict) // Correctif P2-02
  matchedSupplierInvoice SupplierInvoice?    @relation(fields: [companyId, matchedSupplierInvoiceId], references: [companyId, id], onDelete: Restrict) // Correctif P2-02
  payments               InvoicePayment[]    @relation("PaymentBankTransaction") // Correctif P1-03 : paiement créé par le rapprochement (au plus un : bankTransactionId UNIQUE)

  @@unique([companyId, id])
  @@unique([companyId, fingerprint])
  @@unique([companyId, externalId])
  @@unique([matchedPaymentId])
  @@index([companyId, status])
  @@index([companyId, date])
  @@map("bank_transactions")
}

enum VatDeclarationStatus {
  DRAFT
  DECLARED
}

model VatDeclaration {
  id              String               @id @default(cuid())
  companyId       String
  periodStart     DateTime             @db.Date
  periodEnd       DateTime             @db.Date
  basis           VatRegime
  collectedCents  BigInt
  deductibleCents BigInt
  dueCents        BigInt
  details         Json
  status          VatDeclarationStatus @default(DECLARED)
  declaredAt      DateTime?
  createdById     String
  createdAt       DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, periodStart, periodEnd])
  @@map("vat_declarations")
}
