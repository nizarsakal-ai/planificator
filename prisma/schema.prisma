enum VehicleDocumentCategory {
  TECHNICAL_INSPECTION // Contrôle technique
  REPAIR_MAINTENANCE   // Réparations et entretien (factures, comptes rendus)
  REGISTRATION         // Carte grise
  INSURANCE            // Assurance
  EXPENSE_RECEIPT
}


model VehicleDocument {
  id                     String                  @id @default(cuid())
  companyId              String
  truckId                String
  category               VehicleDocumentCategory
  title                  String
  currentVersionId       String?
  revision               Int                     @default(1)
  archivedAt             DateTime?               @db.Timestamptz(3)
  archivedById           String?
  archivedByNameSnapshot String?
  archiveReason          String?
  createdAt              DateTime                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  createdById            String
  createdByNameSnapshot  String
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  truck          Truck                     @relation(fields: [truckId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User                      @relation("VehicleDocumentAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentVersion VehicleDocumentVersion?   @relation("VehicleDocumentCurrentVersion", fields: [currentVersionId, id, companyId], references: [id, documentId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_documents_current_version_fkey")
  versions       VehicleDocumentVersion[]  @relation("VehicleDocumentVersions")
  reminders      VehicleDocumentReminder[]

  @@unique([id, truckId, companyId], map: "vehicle_documents_id_truck_company_key")
  @@unique([currentVersionId, id, companyId], map: "vehicle_documents_current_version_document_company_key")
  @@index([companyId, truckId, category])
  @@map("vehicle_documents")
}


model VehicleDocumentVersion {
  id                     String    @id @default(cuid())
  companyId              String
  truckId                String
  documentId             String
  versionNumber          Int
  storageProvider        String
  storageKey             String
  storageResourceType    String
  storageDeliveryType    String
  originalFilename       String
  mimeType               String
  sizeBytes              Int
  sha256                 String    @db.Char(64)
  // Dates métier (jour civil, interprété dans le fuseau de l'entreprise)
  issuedOn               DateTime? @db.Date
  validFrom              DateTime? @db.Date
  validUntil             DateTime? @db.Date
  // Métadonnées typées facultatives selon la rubrique
  issuerName             String?
  referenceNumber        String?
  observations           String?   @db.Text
  // Kilométrage mentionné sur la pièce : information, jamais appliqué au compteur V2
  mileage                Int?
  // Lien facultatif vers une intervention V2 existante ; une facture ancienne sans
  // kilométrage reste conservable sans créer d'intervention fictive.
  maintenanceEntryId     String?
  uploadedById           String
  uploadedByNameSnapshot String
  uploadedAt             DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  verifiedAt             DateTime? @db.Timestamptz(3)
  verifiedById           String?
  verifiedByNameSnapshot String?
  supersededAt           DateTime? @db.Timestamptz(3)
  idempotencyKey         String    @db.Uuid
  requestHash            String    @db.Char(64)

  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  truck            Truck                     @relation(fields: [truckId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  document         VehicleDocument           @relation("VehicleDocumentVersions", fields: [documentId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_document_versions_document_truck_company_fkey")
  uploadedBy       User                      @relation("VehicleDocumentVersionAuthor", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  maintenanceEntry VehicleMaintenanceEntry?  @relation("VehicleDocumentMaintenanceEntry", fields: [maintenanceEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_document_versions_maintenance_entry_fkey")
  currentOf        VehicleDocument?          @relation("VehicleDocumentCurrentVersion")
  reminders        VehicleDocumentReminder[]

  @@unique([id, documentId, companyId], map: "vehicle_document_versions_id_document_company_key")
  @@unique([documentId, versionNumber], map: "vehicle_document_versions_document_number_key")
  @@unique([companyId, truckId, idempotencyKey], map: "vehicle_document_versions_company_truck_idempotency_key")
  @@unique([companyId, storageKey], map: "vehicle_document_versions_company_storage_key")
  @@index([companyId, validUntil])
  @@index([maintenanceEntryId, truckId, companyId], map: "vehicle_document_versions_maintenance_entry_idx")
  @@map("vehicle_document_versions")
  expenses VehicleExpense[] @relation("VehicleExpenseDocument")
  @@unique([id, truckId, companyId], map: "vehicle_document_versions_id_truck_company_key")
}


