  commands              VehicleExpenseCommand[]

  @@unique([id, truckId, companyId])
  @@unique([companyId, sourceExpenseReportId])
  @@index([companyId, truckId, occurredAt])
  @@map("vehicle_expenses")
  documentVersion VehicleDocumentVersion? @relation("VehicleExpenseDocument", fields: [documentVersionId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_expenses_document_scope_fkey")
  maintenanceEntry VehicleMaintenanceEntry? @relation("VehicleExpenseMaintenance", fields: [maintenanceEntryId, truckId, companyId], references: [id, truckId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "vehicle_expenses_maintenance_scope_fkey")
