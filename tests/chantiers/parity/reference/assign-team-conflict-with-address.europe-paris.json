{
  "id": "assign-team-conflict-with-address",
  "action": "affecterEquipe",
  "title": "conflit équipe, chantier existant avec adresse",
  "input": {
    "session": "admin",
    "form": {
      "worksiteId": "worksite-1",
      "teamId": "team-1",
      "dateFrom": "2026-11-03",
      "dateTo": "2026-11-05"
    },
    "geocode": null,
    "email": "resolve",
    "dbScriptKeys": [
      "worksite.findFirst",
      "team.findFirst",
      "assignment.findFirst",
      "employeeAssignment.findMany",
      "assignment.create",
      "employeeAssignment.createMany",
      "worksite.update",
      "notification.create",
      "user.findUnique",
      "company.findUnique"
    ]
  },
  "result": {
    "returned": {
      "error": "Cette équipe est déjà affectée le 04 novembre au chantier « Chantier Bêta » (3 place du Marché, Rouen). Libérez-la de ce chantier avant de la réaffecter."
    }
  },
  "trace": [
    {
      "kind": "auth",
      "session": "admin"
    },
    {
      "kind": "prisma",
      "model": "worksite",
      "method": "findFirst",
      "args": {
        "where": {
          "id": "worksite-1",
          "companyId": "company-A"
        }
      },
      "inTx": false
    },
    {
      "kind": "prisma",
      "model": "team",
      "method": "findFirst",
      "args": {
        "where": {
          "id": "team-1",
          "companyId": "company-A"
        },
        "include": {
          "members": {
            "where": {
              "leftAt": null
            },
            "select": {
              "employeeId": true
            }
          },
          "leader": {
            "select": {
              "userId": true
            }
          }
        }
      },
      "inTx": false
    },
    {
      "kind": "prisma",
      "model": "assignment",
      "method": "findFirst",
      "args": {
        "where": {
          "teamId": "team-1",
          "date": {
            "in": [
              {
                "$date": "2026-11-02T23:00:00.000Z"
              },
              {
                "$date": "2026-11-03T23:00:00.000Z"
              },
              {
                "$date": "2026-11-04T23:00:00.000Z"
              }
            ]
          }
        },
        "include": {
          "worksite": {
            "select": {
              "name": true,
              "address": true
            }
          }
        },
        "orderBy": {
          "date": "asc"
        }
      },
      "inTx": false
    }
  ]
}
