              },
              {
                "$date": "2026-11-04T00:00:00.000Z"
              },
              {
                "$date": "2026-11-05T00:00:00.000Z"
              }
            ]
          }
        },
        "include": {
          "employee": {
            "select": {
              "firstName": true,
              "lastName": true
            }
          },
          "assignment": {
            "select": {
              "worksite": {
                "select": {
                  "name": true
                }
              },
              "team": {
                "select": {
                  "name": true
                }
              }
            }
          }
        },
        "orderBy": [
