+    const r = await assignTeamCore({ ...INPUT, dateFrom: "2026-11-05", dateTo: "2026-11-03" }, ACTOR, deps)
+    assert.deepEqual(r, { ok: false, code: "VALIDATION", details: { message: "La date de fin doit être après la date de début." } })
